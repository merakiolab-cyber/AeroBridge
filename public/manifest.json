{
  "id": "aerobridge-studio-app",
  "name": "AeroBridge Studio",
  "short_name": "AeroBridge",
  "description": "Ultra-rychlý moderní digitální asset manažer a organizér médií — lehká offline alternativa k Adobe Bridge.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121316",
  "theme_color": "#16171a",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "categories": ["utilities", "productivity", "photo"],
  "shortcuts": [
    {
      "name": "Otevřít složku",
      "short_name": "Složka",
      "description": "Otevřít složku z disku v AeroBridge",
      "url": "/?action=open-folder",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Oblíbené projekty",
      "short_name": "Oblíbené",
      "description": "Rychlý přechod do oblíbených projektů",
      "url": "/?action=favorites",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "AeroBridge Media Handler",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }],
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".svg", ".gif", ".bmp"],
        "video/*": [".mp4", ".webm", ".mov"],
        "application/x-photoshop": [".psd"],
        "application/illustrator": [".ai"],
        "application/pdf": [".pdf"]
      }
    }
  ]
}
